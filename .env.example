# ==============================================================================
# Gemstone Processing & Lifecycle Management - Production Environment Template
# Copy this file to .env.local for local development, or set these variables
# in your hosting dashboard (Vercel, Railway, Docker, AWS ECS, etc.)
# ==============================================================================

# 1. Supabase API Credentials
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 2. Production Canonical Site URL
# Crucial for email verification links and OAuth callbacks.
# In production, set to your custom domain or Vercel URL (e.g. https://vault.gemstone.com)
# In development, defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
